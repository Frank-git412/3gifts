{
  // Configurazione Cloudflare Workers per 3gifts.it.
  // Il segreto AMAZON_CREATORS_CLIENT_SECRET si imposta con `wrangler secret put` o dal
  // pannello Cloudflare (tipo Secret), mai in questo file. Il Client ID è un identificativo
  // dell'applicazione, non una credenziale: sta qui perché ogni deploy rimuove le variabili
  // in chiaro create dal pannello.
  "name": "3gifts",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "build": { "command": "node scripts/build-worker.mjs" },
  // Library product job: matches a few concepts and refreshes prices every hour.
  "triggers": { "crons": ["17 * * * *"] },
  // Static files from dist/ are served by Cloudflare; every request reaches the Worker first
  // for redirects, APIs, guides and headers, and it reads the files through the STATIC binding.
  "assets": { "directory": "dist", "binding": "STATIC", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "vars": {
    "AMAZON_CREATORS_CLIENT_ID": "amzn1.application-oa2-client.cc4a0c116fe4405abbeec0dd5127e20a",
    "AMAZON_CREATORS_VERSION": "3.2",
    "AMAZON_PARTNER_TAG": "3gifts-21"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3gifts",
      "database_id": "3ae9586c-8476-404c-b59a-393ffff0e5fc",
      "migrations_dir": "drizzle"
    }
  ]
}
